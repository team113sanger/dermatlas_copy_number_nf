nextflow_workflow {

    name "Test Workflow DERMATLAS_METADATA"
    script "subworkflows/local/process_metadata.nf"
    workflow "DERMATLAS_METADATA"

    test("Should run without failures - no underscores in manifest") {

        when {
        params {
            load("$baseDir/tests/testdata/test_params.json")
        }
            workflow {
                """
                input[0] = channel.fromPath("s3://t113-test-artefacts/nf-test/dermatlas_copynumber_nf/bams/PD57536a/PD57536a.sample.dupmarked.bam")
                input[1] = channel.fromPath("$baseDir/tests/testdata/pair_ids.tsv")
                input[2] = channel.fromPath("s3://t113-test-artefacts/nf-test/dermatlas_copynumber_nf/metadata/6509_6510_Leiomyoma.tsv")
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }
    }

}
