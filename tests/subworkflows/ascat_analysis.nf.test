nextflow_workflow {

    name "Test Workflow ASCAT_ANALYSIS"
    script "subworkflows/ascat_analysis.nf"
    workflow "ASCAT_ANALYSIS"

    test("Should run without failures") {

        when {
            params {
                load("$baseDir/tests/testdata/test_params.json")
            }
            workflow {
                """
                // define inputs of the workflow here. Example:
                input[0] = tuple(
                [pair_id: "PD54403a_PD54403b", normal: "PD54403a", tumor: "PD54403b", Sex: "M", Phenotype: "N", Karyotype: "XY"],
                file("/lustre/scratch125/casm/teams/team113/secure-lustre/team113/nf-test/bams/PD54403a/PD54403a.sample.dupmarked.bam"),
                file("/lustre/scratch125/casm/teams/team113/secure-lustre/team113/nf-test/bams/PD54403a/PD54403a.sample.dupmarked.bam.bai"),
                file("/lustre/scratch125/casm/teams/team113/secure-lustre/team113/nf-test/bams/PD54403b/PD54403b.sample.dupmarked.bam"),
                file("/lustre/scratch125/casm/teams/team113/secure-lustre/team113/nf-test/bams/PD54403b/PD54403b.sample.dupmarked.bam.bai"))
                input[1] = file("${params.reference_genome}")
                input[2] = file("${params.bait_set}")
                input[3] = file("${params.resource_files}")
                input[4] = file("${params.gc_file}")
                input[5] = file("${params.rt_file}")
                input[6] = ["0.9"]
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
