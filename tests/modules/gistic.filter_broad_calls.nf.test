nextflow_process {

    name "Test Process FILTER_BROAD_GISTIC2_CALLS"
    script "modules/gistic2.nf"
    process "FILTER_BROAD_GISTIC2_CALLS"
    tag "ci"
    test("Should run without failures") {

        when {
        params {
            load("$baseDir/tests/testdata/test_params.json")
        }
            process {
                """
                input[0] = tuple([analysis_type: "test", plot_dir: "test"], file("$baseDir/tests/testdata/ascat_segments.tsv"), file("$baseDir/tests/testdata/broad_significance_results.txt"), file("$baseDir/tests/testdata/broad_values_by_arm.txt"))
                input[1] = file("$baseDir/tests/testdata/ucsc_chrom_arms.txt")
                input[2] = 0.1
                input[3] = "test"
                """
            }
        }

        then {
            assert process.success
        }

    }

}
