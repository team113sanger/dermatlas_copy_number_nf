params {
    // Every projectify location below comes from the project source_me.sh.
    // run_copy_number.sh checks these are exported before nextflow is launched -
    // an unset variable is not an error to the config parser, it silently becomes
    // the literal '[:]', so the guard in the wrapper is what catches it.
    outdir = "${ANALYSIS_DIR}"
    cohort_prefix = "${STUDY}_${PROJECT}_${COHORT}"
    bam_files = "${BAMS_DIR}/**.bam"
    all_samples = "${DNA_PAIR_LIST_ANALYSED_MATCHED}"
    metadata_manifest = "${COHORT_METADATA_FILE}"

    // Define subcohorts - each key is the subcohort name, each value a sample_list of
    // tumour-normal pairs and the plot directory for that subcohort.
    // The sample lists are generated and versioned by dermanager, so it owns their paths.
    subcohorts = [
        "independent_tumours": [
            sample_list: "${DNA_PAIR_LIST_INDEPENDENT_TUMOURS_MATCHED}",
            plot_dir: "PLOTS_INDEPENDENT"
        ],
        "one_tumour_per_patient": [
            sample_list: "${DNA_PAIR_LIST_ONE_TUMOUR_PER_PATIENT_MATCHED}",
            plot_dir: "PLOTS_ONE_PER_PATIENT"
        ],
        // Empty for most cohorts; a subcohort with no pairs produces no outputs.
        "related_tumours": [
            sample_list: "${DNA_PAIR_LIST_RELATED_TUMOURS_MATCHED}",
            plot_dir: "PLOTS_RELATED"
        ]
    ]

    // Cohort-independent, pipeline-owned: not a source_me.sh concern.
    reference_genome = "/lustre/scratch127/casm/projects/dermatlas/resources/ascat/GRCh38_full_analysis_set_plus_decoy_hla.fa"
    bait_set = "/lustre/scratch127/casm/projects/dermatlas/resources/baitset/GRCh38_WES5_canonical_pad100.merged.bed"
    resource_files = "/lustre/scratch127/casm/projects/dermatlas/resources/ascat/1000G_loci_hg38_chr"
    gc_file = "/lustre/scratch127/casm/projects/dermatlas/resources/ascat/1000G_GC_exome_chr.txt"
    rt_file = "/lustre/scratch127/casm/projects/dermatlas/resources/ascat/1000G_RT_exome_chr.txt"
    gistic_refgene_file = "/lustre/scratch127/casm/projects/dermatlas/resources/gistic/hg38.UCSC.add_miR.160920.refgene.mat"
    difficult_regions_file = "/lustre/scratch127/casm/projects/dermatlas/resources/giab/GRCh38_alldifficultregions.bed"
    chrom_arms_file =  "/lustre/scratch127/casm/projects/dermatlas/resources/ucsc/grch38_chr_arms.bed"
    ensembl_transcript = "/lustre/scratch127/casm/projects/dermatlas/resources/ensembl/Homo_sapiens.GRCh38.103.chr.gff3.gz"
    cancer_gene_list = "/lustre/scratch127/casm/projects/dermatlas/resources/gistic/cancer_gene_matrix.tsv"
    oncokb_file = "/lustre/scratch127/casm/projects/dermatlas/resources/oncokb/cancerGeneList.nocosmic.tsv"
    gistic_broad_peak_q_cutoff = 0.1
    gistic_focal_q_value_cutoff = 0.1
    gistic_log2_thresholds = "'-0.2,0.2'"
    ascat_goodness_of_fit_threshold = 90
    release_version = "version1"
    col_sample_id = 'Sanger_DNA_ID'
    col_sex = 'Sex'
    col_include = 'OK_to_analyse_DNA?'
    col_TN = 'Phenotype'

    // Run reporting needs no params here: it is gated by the DERMATLAS_WEBSITE_LOGGING /
    // DERMATLAS_SLACK_NOTIFICATIONS env vars exported by run_copy_number.sh, and the
    // pipeline's onComplete handler reads the payload values (COHORT_SLUG,
    // SAMPLE_LIST_VERSION_FILE, SELF_DESCRIBING_API, SLACK_WEBHOOK_URL) straight from
    // the environment.
}
