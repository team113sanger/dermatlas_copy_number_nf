
/*
========================================================================================
  Nextflow config file
========================================================================================
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// One id names all of a run's artifacts - nextflow log (nextflow-<RUN_ID>.log),
// execution trace (execution_trace-<RUN_ID>.txt) and execution report
// (execution_report-<RUN_ID>.html) - so they can be matched up at a glance.
// The run wrapper computes and exports RUN_ID (label/study_project_cohort plus a
// YYYYMMDDTHHMMSS timestamp); direct `nextflow run` invocations fall back to a
// bare timestamp in the same format.
def run_id = System.getenv('RUN_ID') ?: new java.util.Date().format("yyyyMMdd'T'HHmmss")

// Where this run's execution trace and report go. The run wrapper exports TRACE_DIR;
// System.getenv (rather than a "${TRACE_DIR}" interpolation) is used deliberately - an
// unset variable in a Nextflow config string silently becomes the literal '[:]', whereas
// getenv returns null and falls back cleanly here.
def trace_dir  = System.getenv('TRACE_DIR') ?: 'results/pipeline_info'
def trace_path = "${trace_dir}/execution_trace-${run_id}.txt"

// Global default params, used in configs
includeConfig 'conf/base.config'
params {

    // Boilerplate options
    outdir                     = './results'
    tracedir                   = "${params.outdir}/pipeline_info"
    // Load-bearing: the run wrapper deletes the work directory after a successful run,
    // which is only safe because publishDir has already copied the results out.
    publish_dir_mode           = 'copy'

    // Skip status reporting for stub/test runs (accepts true/false/1/0).
    // `-stub-run` on the CLI (workflow.stubRun) is also honoured, so this flag
    // is only needed where that is unavailable.
    is_stub                    = false

    // Run reporting is deliberately kept out of the workflow's params: it is gated by
    // two env-var opt-ins exported by the run wrapper (see assets/run_copy_number.sh)
    // and lib/Utils.groovy reads everything it needs (COHORT_SLUG,
    // SAMPLE_LIST_VERSION_FILE, SELF_DESCRIBING_API, SLACK_WEBHOOK_URL, RUN_ID)
    // straight from the environment in the onComplete handler:
    //   DERMATLAS_WEBSITE_LOGGING     - record the run via `dermatlas-http cohort
    //                                   analysis-log` (>= 0.6.1).
    //   DERMATLAS_SLACK_NOTIFICATIONS - post a Slack message on completion.
    // The one reporting value that is a param is this pipeline's own slug in the
    // analysis log - pipeline-owned metadata, like the manifest version.
    analysis_pipeline_slug     = 'copynumber_pipe'

    // Path of this run's execution trace. Assigned from the same value as trace.file below,
    // so the two can never drift; read by the onComplete handler and attached to the
    // analysis-log record (--nextflow-performance) when website logging is opted in.
    trace_file                 = trace_path

    // Pipeline utility options
    print_version              = true
    dump_parameters            = true
    check_conda_channels       = false

    // Max requirements
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'

    // Configurable column names from input manifests
    // Patient metadata file columns
    col_sample_id              = 'Sanger_DNA_ID'
    col_sex                    = 'Sex'
    col_include                = 'OK_to_analyse_DNA?'
    col_TN                     = 'Phenotype'
} 

profiles {
    secure_lustre {
        process.executor = 'local'
        
        docker {
        enabled = true
        runOptions = '-u $(id -u):$(id -g)'
        }
        process {
            withName: RUN_ASCAT_EXOMES {
            cpus = 8
            memory = 40.GB
        }}

        singularity {
            enabled    = false
            autoMounts = false
        }
    }

    farm22 {
        process.executor = 'lsf'
        singularity.runOptions = "--bind /lustre"

        docker {
        enabled = false
        }
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir = '/lustre/scratch127/casm/projects/dermatlas/singularity_images'
            registry = 'gitlab-registry.internal.sanger.ac.uk'
            }
        executor {
            name = 'lsf'
            perJobMemLimit = true
            poolSize = 4
            submitRateLimit = '5 sec'
            killBatchSize = 50
        }
        process {
            withName: RUN_ASCAT_EXOMES {
            cpus = 18
            memory = 40.GB
            }
            }
        params {
            subcohorts = false
            reference_genome = "/lustre/scratch127/casm/projects/dermatlas/resources/ascat/GRCh38_full_analysis_set_plus_decoy_hla.fa"
            bait_set = "/lustre/scratch127/casm/projects/dermatlas/resources/baitset/GRCh38_WES5_canonical_pad100.merged.bed"
            resource_files = "/lustre/scratch127/casm/projects/dermatlas/resources/ascat/1000G_loci_hg38_chr"
            gc_file = "/lustre/scratch127/casm/projects/dermatlas/resources/ascat/1000G_GC_exome_chr.txt"
            rt_file = "/lustre/scratch127/casm/projects/dermatlas/resources/ascat/1000G_RT_exome_chr.txt"
            gistic_refgene_file = "/lustre/scratch127/casm/projects/dermatlas/resources/gistic/hg38.UCSC.add_miR.160920.refgene.mat"
            difficult_regions_file = "/lustre/scratch127/casm/projects/dermatlas/resources/giab/GRCh38_alldifficultregions.bed"
            chrom_arms_file =  "/lustre/scratch127/casm/projects/dermatlas/resources/ucsc/grch38_chr_arms.bed"
            ensembl_transcript = "/lustre/scratch127/casm/projects/dermatlas/resources/ensembl/Homo_sapiens.GRCh38.103.chr.gff3.gz"
            cancer_gene_list = "/lustre/scratch127/casm/projects/dermatlas/resources/gistic/cancer_gene_matrix.tsv"
            oncokb_file = "/lustre/scratch127/casm/projects/dermatlas/resources/oncokb/cancerGeneList.nocosmic.tsv"
            gistic_broad_peak_q_cutoff = 0.1
            gistic_focal_q_value_cutoff = 0.1
            gistic_log2_thresholds = '-0.2,0.2'
            ascat_goodness_of_fit_threshold = 90
            }
        }
}



// Both built from trace_dir, not params.tracedir: that resolves eagerly against the
// default outdir, so the report would otherwise land in ./results/pipeline_info.
report {
    enabled = true
    file    = "${trace_dir}/execution_report-${run_id}.html"
}

trace {
    enabled   = true
    file      = trace_path
    overwrite = false
}


manifest {
    name            = 'dermatlas_copy_number_nf'
    author          = 'Kim Wong, Jamie Billington'
    homePage        = 'https://github.com/team113sanger/dermatlas_copy_number_nf'
    description     = 'Copy Number analysis pipeline for Dermatlas'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.04.5'
    version         = '1.2.0'
    defaultBranch   = 'develop'
}

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}